" =============================================================================
" .ideavimrc — IdeaVim config cho GoLand
" Dựa trên phân tích toàn bộ Neovim config
" Đặt file này tại ~/.ideavimrc (symlink hoặc copy)
" =============================================================================

" ─── Leader ──────────────────────────────────────────────────────────────────
let mapleader=" "

" ─── Options (từ options.lua / init.lua) ─────────────────────────────────────
set scrolloff=5
set sidescrolloff=8
set incsearch
set hlsearch
set ignorecase
set smartcase
set number
set relativenumber
set showmode
set showcmd
set clipboard=unnamedplus
set timeoutlen=400
set wrap
set whichwrap+=<,>,h,l,[,]

" ─── IdeaVim Plugins ────────────────────────────────────────────────────────
" https://jb.gg/ideavim-plugins
Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'

set easymotion                 " <leader><leader>w, s, f ...
set NERDTree                   " File explorer (:NERDTree)
set argtextobj                 " Text object cho arguments: aa, ia
set textobj-entire             " Text object cho toàn file: ae, ie
set ReplaceWithRegister        " gr{motion} để replace bằng register
set exchange                   " cx{motion} để exchange
set multiple-cursors           " <A-n> select next occurrence
set which-key                  " Hiển thị phím tắt popup
set notimeout                  " which-key không timeout
set vim-paragraph-motion       " Cải thiện { } motion
set textobj-indent             " Text object cho indent: ii, ai

" IdeaVim-specific
set ideajoin                   " Smart join (J) dùng IDE logic
set idearefactormode=keep      " Giữ mode khi refactor

" ─── Xoá highlight tìm kiếm ─────────────────────────────────────────────────
nnoremap <Esc> :noh<CR>

" ─── Di chuyển dòng (<C-j>/<C-k> từ mappings.lua) ───────────────────────────
nnoremap <C-j> :action MoveLineDown<CR>
nnoremap <C-k> :action MoveLineUp<CR>
inoremap <C-j> <Esc>:action MoveLineDown<CR>gi
inoremap <C-k> <Esc>:action MoveLineUp<CR>gi
vnoremap <C-j> :action MoveLineDown<CR>gv
vnoremap <C-k> :action MoveLineUp<CR>gv

" ─── Split & Window Navigation (<leader>h/j/k/l, | từ mappings.lua) ─────────
nnoremap <Bar>        :action SplitVertically<CR>
nnoremap <leader>h    <C-w>h
nnoremap <leader>l    <C-w>l
nnoremap <leader>j    <C-w>j
nnoremap <leader>k    <C-w>k

" ─── Tab/Buffer Navigation (<C-h/l>, <leader>x từ mappings.lua) ─────────────
nnoremap <C-l>        :action NextTab<CR>
nnoremap <C-h>        :action PreviousTab<CR>
nnoremap <leader>x    :action CloseContent<CR>
nnoremap <leader>b    :action NewScratchBuffer<CR>
nnoremap <leader>tn   :action NextTab<CR>

" ─── File Explorer (<C-f> NvimTree từ mappings.lua) ──────────────────────────
nnoremap <C-f>        :NERDTreeToggle<CR>

" ─── Tìm kiếm — Telescope → GoLand Actions ──────────────────────────────────
nnoremap <leader>ff   :action GotoFile<CR>
nnoremap <leader>fa   :action GotoFile<CR>
nnoremap <leader>fw   :action FindInPath<CR>
nnoremap <leader>fb   :action Switcher<CR>
nnoremap <leader>fo   :action RecentFiles<CR>
nnoremap <leader>fc   :action Find<CR>
nnoremap <leader>fp   :action FileStructurePopup<CR>
nnoremap <leader>fh   :action HelpTopics<CR>
nnoremap <leader>ma   :action ShowBookmarks<CR>
nnoremap <leader>cm   :action Vcs.ShowTabbedFileHistory<CR>
nnoremap <leader>ds   :action ActivateProblemsViewToolWindow<CR>
nnoremap <leader>pj   :action ManageRecentProjects<CR>

" ─── LSP / Code Navigation (từ lspconfig.lua + mappings.lua) ────────────────
nnoremap gd           :action GotoDeclaration<CR>
nnoremap gD           :action GotoDeclaration<CR>
nnoremap gi           :action GotoImplementation<CR>
nnoremap gM           :action GotoImplementation<CR>
nnoremap gr           :action FindUsages<CR>
nnoremap gR           :action FindUsages<CR>
nnoremap gY           :action GotoTypeDeclaration<CR>
nnoremap K            :action QuickJavaDoc<CR>
nnoremap <C-i>        :action ParameterInfo<CR>
nnoremap <space>D     :action GotoTypeDeclaration<CR>
nnoremap <space>rn    :action RenameElement<CR>
nnoremap <space>q     :action ActivateProblemsViewToolWindow<CR>
nnoremap [d           :action GotoPreviousError<CR>
nnoremap ]d           :action GotoNextError<CR>
nnoremap ]m           :action MethodDown<CR>
nnoremap [m           :action MethodUp<CR>

" ─── Code Actions & Format (<leader>ca, <leader>fm từ mappings.lua) ──────────
nnoremap <leader>ca   :action ShowIntentionActions<CR>
xnoremap <leader>ca   :action ShowIntentionActions<CR>
nnoremap <leader>fm   :action ReformatCode<CR>

" ─── Debug (DAP mappings từ mappings.lua → GoLand Debug) ─────────────────────
nnoremap <F5>         :action Resume<CR>
nnoremap <F6>         :action Rerun<CR>
nnoremap <F4>         :action Stop<CR>
nnoremap <C-b>        :action ToggleLineBreakpoint<CR>
nnoremap <leader>ui   :action ActivateDebugToolWindow<CR>
nnoremap <space>i     :action QuickEvaluateExpression<CR>
xnoremap <space>i     :action QuickEvaluateExpression<CR>
nnoremap <leader>dc   :action ActivateDebugToolWindow<CR>
nnoremap <leader>dt   :action ViewBreakpoints<CR>
nnoremap <leader>dr   :action EvaluateExpression<CR>

" ─── Run & Terminal (<F10>, <F12> từ mappings.lua) ───────────────────────────
nnoremap <F10>        :action RunClass<CR>
nnoremap <F12>        :action ActivateTerminalToolWindow<CR>
nnoremap <space>fr    :action Run<CR>
nnoremap <space>fd    :action ChooseDebugConfiguration<CR>

" ─── Git (gitsigns + lazygit từ mappings.lua) ────────────────────────────────
nnoremap <leader>gb   :action Annotate<CR>
nnoremap <leader>gl   :action Vcs.ShowCurrentChangeMarker<CR>
nnoremap <leader>gf   :action ActivateVersionControlToolWindow<CR>
nnoremap <leader>gt   :action Vcs.Show.Local.Changes<CR>
nnoremap <leader>rh   :action Vcs.RollbackChangedLines<CR>
nnoremap <leader>ph   :action Vcs.ShowDiffChangedLines<CR>

" ─── Toggle & Misc ──────────────────────────────────────────────────────────
nnoremap <leader>rn   :set relativenumber!<CR>
nnoremap <leader>n    :set number!<CR>
nnoremap <leader>zm   :action ToggleDistractionFreeMode<CR>
nnoremap <leader>:    :action GotoAction<CR>
nnoremap <leader>rl   :action RecentLocations<CR>

" Comment toggle (commentary plugin: gcc cho dòng, gc cho visual)
nnoremap <leader>/    gcc
vnoremap <leader>/    gc

" ─── EasyMotion ──────────────────────────────────────────────────────────────
nmap s                <Plug>(easymotion-s)
nmap S                <Plug>(easymotion-s2)
nmap <leader><leader>w <Plug>(easymotion-w)
nmap <leader><leader>b <Plug>(easymotion-b)
nmap <leader><leader>j <Plug>(easymotion-j)
nmap <leader><leader>k <Plug>(easymotion-k)

" ─── Multiple Cursors ────────────────────────────────────────────────────────
nnoremap mc           :action SelectNextOccurrence<CR>
vnoremap mc           :action SelectNextOccurrence<CR>
nnoremap mca          :action SelectAllOccurrences<CR>
vnoremap mca          :action SelectAllOccurrences<CR>
nnoremap <A-x>        :action UnselectPreviousOccurrence<CR>
nnoremap <C-S-Up>     :action EditorCloneCaretAbove<CR>
nnoremap <C-S-Down>   :action EditorCloneCaretBelow<CR>

" ─── Folding ─────────────────────────────────────────────────────────────────
nnoremap za           :action ExpandCollapseToggleAction<CR>
nnoremap zc           :action CollapseRegion<CR>
nnoremap zo           :action ExpandRegion<CR>
nnoremap zM           :action CollapseAllRegions<CR>
nnoremap zR           :action ExpandAllRegions<CR>

" ─── Refactoring (Go & general) ──────────────────────────────────────────────
nnoremap <leader>re   :action ExtractMethod<CR>
xnoremap <leader>re   :action ExtractMethod<CR>
nnoremap <leader>rv   :action IntroduceVariable<CR>
xnoremap <leader>rv   :action IntroduceVariable<CR>
nnoremap <leader>ri   :action Inline<CR>
nnoremap <leader>rf   :action IntroduceField<CR>
nnoremap <leader>rs   :action ChangeSignature<CR>
nnoremap <leader>ro   :action OptimizeImports<CR>

" ─── Generate (Go struct tags, tests, interface impl) ────────────────────────
nnoremap <leader>ge   :action Generate<CR>
nnoremap <leader>go   :action OverrideMethods<CR>
nnoremap <leader>gs   :action GotoSuperMethod<CR>
nnoremap <leader>gu   :action ShowUsages<CR>
nnoremap <leader>gc   :action CallHierarchy<CR>

" ─── Noice-like notifications (từ mappings.lua <leader>nl/nh) ────────────────
nnoremap <leader>nl   :action ShowEventLog<CR>
nnoremap <leader>nh   :action ShowEventLog<CR>

" ─── Q for formatting ────────────────────────────────────────────────────────
map Q gq
